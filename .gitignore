gia-pre-implementation/raw_course_catalogs/college_two/cache/

# Institution dashboard: CSVs uploaded in the app, not committed
gia-pre-implementation/synthetic-datasets/uploads/

# Personal OpenRouter client, kept local and not tracked
gia-pre-implementation/openrouter/

