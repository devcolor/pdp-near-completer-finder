# Every setting the API reads, with its default. Documentation only: the API loads
# .env.<APP_ENV> and .env.<APP_ENV>.local (git-ignored), and real environment variables win.
# Copy what you need into .env.<APP_ENV>.local or your host's environment variables.
# Never put real secrets in a committed file.

# development | staging | production
APP_ENV=development

# Database. Required. postgres:// URLs are converted to the async driver; sqlite:// works too.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Web app origins allowed to call the API, as a JSON list.
CORS_ORIGINS=["http://localhost:3000"]

# Folder with the college CSVs for /dashboard. Empty means gia-pre-implementation/synthetic-datasets.
DASHBOARD_DATA_DIR=
# Where /dashboard saves uploaded CSVs. Empty means an "uploads" folder inside the data folder.
# On a read-only host such as Vercel, use a writable path like /tmp/dashboard-uploads.
DASHBOARD_UPLOAD_DIR=

# Mock-data endpoints behind the web app's example charts. Turn off in production.
SANDBOX_ENABLED=true
# Largest file /sandbox/pipeline/uploads accepts, in bytes (100 MB).
PIPELINE_UPLOAD_MAX_BYTES=104857600

# Sandbox chat. Optional; without a key the chat endpoint answers 503. Use your own key.
ANTHROPIC_API_KEY=<your-anthropic-api-key>
SANDBOX_CHAT_MODEL=claude-sonnet-5-5

# Fixed values; override only if you know you need to.
PROJECT_NAME=Playground API
VERSION=0.1.0
API_V1_PREFIX=/api/v1
