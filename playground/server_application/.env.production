# Production placeholder. Committed: non-secret settings only.
# Secrets (DATABASE_URL) come from the hosting platform's environment variables.
APP_ENV=production
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
CORS_ORIGINS=["https://example.com"]
SANDBOX_ENABLED=false
# Vercel's bundle is read-only; uploads go to /tmp and do not survive a cold start.
DASHBOARD_UPLOAD_DIR=/tmp/dashboard-uploads
